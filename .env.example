# MeshSMS Environment Configuration

# App
APP_NAME=MeshSMS
DEBUG=true
PORT=8000

# Database
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./meshsms.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://meshsms:secret_meshsms_pw@postgres:5432/meshsms

# Jasmin SMS Gateway HTTP API
JASMIN_SEND_URL=http://localhost:1401/send
JASMIN_USER=gateway_api_user
JASMIN_PASS=super_secret_pwd
PUBLIC_DLR_CALLBACK_URL=http://host.docker.internal:8000/internal/dlr-webhook

# Set to true to mock Jasmin responses when running without Docker/Jasmin
MOCK_JASMIN=false

# Jasmin Telnet CLI (jcli)
JASMIN_TELNET_HOST=127.0.0.1
JASMIN_TELNET_PORT=8990
JASMIN_TELNET_USER=jcliadmin
JASMIN_TELNET_PASS=jclipwd

# Billing
DEFAULT_COST_PER_SEGMENT=0.0150
DLR_EXPIRY_HOURS=72
